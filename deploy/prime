#!/usr/bin/env python3
"""`prime`: open the harness in the sandbox VPS from any Mac terminal.

    prime                  agents view: every live session, attach or start one from there
    prime new [args]       a new interactive session (args go to prime-agent)
    prime <args>           any other prime-agent command in the sandbox (list, attach <agent>, send, ...)
    prime ssh              a shell in the sandbox container (agent env loaded)
    prime host             a root shell on the VPS itself
    prime web              open the observer web UI (/bench) at http://127.0.0.1:8790 and copy its token
    prime status           container, observer, link
    prime link [stop|status]
                           the background ssh link every command starts: VPS 127.0.0.1:18080 -> this
                           Mac's m1-lab forwarder (the lab M1 model) and this Mac's 127.0.0.1:8790 -> the
                           observer. Reconnects by itself.

The VPS is the ssh alias `prime-vps` (~/.ssh/config), overridable with $PRIME_VPS. The sandbox runs
as the Docker container `prime-agent` there (deploy/vps/vps.sh). Install:
ln -s <repo>/deploy/prime ~/.local/bin/prime
"""

from __future__ import annotations

import os
import shlex
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
ENV_FILE = HERE / ".env"
VPS = os.environ.get("PRIME_VPS", "prime-vps")
CONTAINER = "prime-agent"
REMOTE_HOME = "/workspace/app/deploy/prime-home.sh"
STATE_DIR = Path.home() / ".config" / "prime"
LINK_PID = STATE_DIR / "link.pid"
LINK_LOG = STATE_DIR / "link.log"
M1_PORT = 18080
WEB_PORT = int(os.environ.get("PRIME_WEB_PORT", "8790"))


def listening(port: int) -> bool:
    with socket.socket() as s:
        s.settimeout(1)
        return s.connect_ex(("127.0.0.1", port)) == 0


def ssh_base() -> list[str]:
    return ["ssh", "-q", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=8"]


def exec_in_sandbox(args: list[str]) -> None:
    # sshd forwards TERM only; the TUI also reads COLORTERM / TERM_PROGRAM for colour depth.
    env = [f"-e {k}={shlex.quote(os.environ[k])}" for k in ("TERM", "COLORTERM", "TERM_PROGRAM") if os.environ.get(k)]
    remote = " ".join(["docker exec -it -u node", *env, CONTAINER, "bash", REMOTE_HOME, *map(shlex.quote, args)])
    os.execvp("ssh", [*ssh_base(), "-t", VPS, remote])


def observer_token() -> str | None:
    if not ENV_FILE.exists():
        return None
    for line in ENV_FILE.read_text().splitlines():
        if line.startswith("PRIME_OBSERVER_TOKEN="):
            return line.split("=", 1)[1].strip().strip("'\"")
    return None


def link_pid() -> int | None:
    try:
        pid = int(LINK_PID.read_text().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def link_start(quiet: bool = False) -> None:
    if link_pid():
        return
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(LINK_LOG, "a") as log:
        proc = subprocess.Popen(
            [sys.executable, os.path.realpath(__file__), "__link-loop"],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
        )
    LINK_PID.write_text(f"{proc.pid}\n")
    if not quiet:
        print(f"prime: link started (pid {proc.pid}, log {LINK_LOG})")


def link_loop() -> None:
    """Hold one ssh open with both forwards; reconnect on any exit."""
    def log(msg: str) -> None:
        print(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {msg}", flush=True)

    while True:
        log(f"linking {VPS}: remote 127.0.0.1:{M1_PORT} -> mac, mac 127.0.0.1:{WEB_PORT} -> observer")
        # The remote forward connects lazily, so it is harmless while the M1 forwarder is down.
        code = subprocess.run(
            [*ssh_base(), "-N", "-o", "ExitOnForwardFailure=yes", "-o", "BatchMode=yes",
             "-R", f"127.0.0.1:{M1_PORT}:127.0.0.1:{M1_PORT}",
             "-L", f"127.0.0.1:{WEB_PORT}:127.0.0.1:8790", VPS],
            stdin=subprocess.DEVNULL,
        ).returncode
        log(f"link exited ({code}); reconnecting in 5 s")
        time.sleep(5)


def link_command(args: list[str]) -> None:
    pid = link_pid()
    if args[:1] == ["stop"]:
        if pid:
            os.killpg(pid, 15)
            print(f"prime: link stopped (pid {pid})")
        LINK_PID.unlink(missing_ok=True)
        return
    if args[:1] == ["status"]:
        print(f"link     {'running (pid %d)' % pid if pid else 'stopped'}; "
              f"M1 forwarder 127.0.0.1:{M1_PORT} {'up' if listening(M1_PORT) else 'down'}; "
              f"web 127.0.0.1:{WEB_PORT} {'up' if listening(WEB_PORT) else 'down'}")
        return
    link_start()


def status() -> None:
    out = subprocess.run(
        [*ssh_base(), "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", VPS,
         f"docker ps -a --filter name=^{CONTAINER}$ --format '{{{{.Status}}}}'; curl -s -m 5 http://127.0.0.1:8790/api/health"],
        capture_output=True, text=True,
    )
    lines = out.stdout.strip().splitlines() or ["unreachable"]
    print(f"vps      {VPS} ({'reachable' if out.returncode == 0 else 'UNREACHABLE: ' + out.stderr.strip()[:120]})")
    print(f"sandbox  {lines[0]}")
    print(f"observer {lines[1][:120] if len(lines) > 1 else 'down'}")
    link_command(["status"])


def web() -> None:
    link_start(quiet=True)
    for _ in range(20):
        if listening(WEB_PORT):
            break
        time.sleep(0.5)
    else:
        sys.exit(f"prime: 127.0.0.1:{WEB_PORT} did not come up; see {LINK_LOG}")
    token = observer_token()
    if token:
        subprocess.run(["pbcopy"], input=token.encode(), check=True)
        print("prime: observer token copied to the clipboard (paste it on the login page once)")
    subprocess.run(["open", f"http://127.0.0.1:{WEB_PORT}/bench"], check=False)


def main(argv: list[str]) -> None:
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip())
        return
    if argv[:1] == ["__link-loop"]:
        link_loop()
        return
    if argv[:1] == ["link"]:
        link_command(argv[1:])
        return
    if argv[:1] == ["status"]:
        status()
        return
    if argv[:1] == ["web"]:
        web()
        return
    link_start(quiet=True)
    if argv[:1] == ["host"]:
        os.execvp("ssh", [*ssh_base(), "-t", VPS])
    if argv[:1] == ["ssh"]:
        exec_in_sandbox(["__shell__"])
    exec_in_sandbox(argv)


if __name__ == "__main__":
    main(sys.argv[1:])
