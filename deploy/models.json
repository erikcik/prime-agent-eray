{
  "providers": {
    "nano-gpt": {
      "name": "NanoGPT",
      "baseUrl": "https://nano-gpt.com/api/v1",
      "api": "openai-completions",
      "apiKey": "NANO_GPT_API_KEY",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": true,
        "supportsUsageInStreaming": true,
        "thinkingFormat": "openai"
      },
      "models": [
        {
          "id": "abliteration-ai/abliterated-model-large-v2",
          "name": "NanoGPT Abliterated Large v2 (GLM-5.3)",
          "reasoning": true,
          "input": [
            "text"
          ],
          "contextWindow": 1000000,
          "maxTokens": 32000,
          "cost": {
            "input": 5,
            "output": 5,
            "cacheRead": 0.5,
            "cacheWrite": 5
          },
          "thinkingLevelMap": {
            "off": "low",
            "minimal": "low",
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "max",
            "max": "max"
          }
        }
      ]
    },
    "local-vllm": {
      "name": "Local vLLM (RunPod GPU pod)",
      "baseUrl": "http://127.0.0.1:8000/v1",
      "api": "openai-completions",
      "apiKey": "VLLM_API_KEY",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "supportsUsageInStreaming": true
      },
      "models": [
        {
          "id": "qwen3.8-27b-abliterated",
          "name": "Qwen3.8-27B abliterated (AWQ-MTP, self-hosted)",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "contextWindow": 131072,
          "maxTokens": 32768,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          }
        }
      ]
    }
  }
}
