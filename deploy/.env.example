# Copy to deploy/.env for docker compose (never commit deploy/.env). On RunPod these are pod env vars.

# Observer login token (>= 16 chars). Generate: openssl rand -hex 24
PRIME_OBSERVER_TOKEN=

# Model providers (env only — RunPod volumes ignore chmod, so no auth.json on the pod)
NANO_GPT_API_KEY=
# Long-lived Claude subscription token from `claude setup-token` (sk-ant-oat01-...). Do NOT copy your Mac's auth.json.
ANTHROPIC_OAUTH_TOKEN=

# Serper key (serper.dev) for the harness's bundled `websearch` skill, which is enabled by default.
# The skill loads either way; without a key the agent reaches for web search and it fails. The harness
# checks this env var FIRST and only falls back to the `serper` credential in auth.json — so setting it
# here keeps the key off the (world-readable) network volume.
SERPER_API_KEY=

# Private repo access for git clone / Refresh: contents of the read-only deploy private key (~/.ssh/prime-agent-eray-deploy)
# Multi-line values: docker compose reads them from a quoted value; on RunPod paste the key as-is.
DEPLOY_GIT_SSH_KEY=
DEPLOY_REPO_URL=git@github.com:erikcik/prime-agent-eray.git
DEPLOY_REPO_BRANCH=main

# Optional: enable sshd for deploy/pod-bind.py (contents of ~/.ssh/prime-agent-pod.pub)
PUBLIC_KEY=

# Optional: extra browser origins allowed to open the observer's WebSocket (comma separated).
# On RunPod https://$RUNPOD_POD_ID-8790.proxy.runpod.net is appended automatically, so a value here
# (e.g. the compose rehearsal's 127.0.0.1:8791) no longer shadows it.
PRIME_OBSERVER_ALLOWED_ORIGINS=

# Optional: default model seeded into settings.json on a FRESH volume only (never overwrites an
# existing settings.json). Unset => anthropic/claude-opus-5 if an Anthropic token is present,
# else nano-gpt. Change these instead of rebuilding the image.
DEPLOY_DEFAULT_PROVIDER=
DEPLOY_DEFAULT_MODEL=

# --- Self-hosted model on a GPU pod (deploy/README-vllm.md) --------------------------------------
# Optional: lets the observer's Ops page create and terminate the GPU pod that serves the local
# model. Deliberately NOT called RUNPOD_API_KEY: the entrypoint scrubs that name from the
# environment so agents can never reach the RunPod control plane (it can delete this pod and its
# volume), then injects this value as RUNPOD_API_KEY into the observer process alone.
# Leave empty to hide nothing but disable the "Deploy model" button.
RUNPOD_DEPLOY_KEY=

# Bearer token the GPU pod's vLLM server requires, and the value the harness sends as the
# local-vllm provider's api key. The RunPod proxy URL is public, so the model server must not run
# without one. Must be the SAME value used when the GPU pod was created (deploy/.vllm-token).
VLLM_API_KEY=
