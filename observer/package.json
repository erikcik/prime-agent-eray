{
	"name": "prime-agent-observer",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Observability + light-control web UI for Prime Agent (sidecar; never modifies packages/*)",
	"engines": {
		"node": ">=22.8.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.server.json && vite build",
		"build:server": "tsc -p tsconfig.server.json",
		"build:web": "vite build",
		"dev:server": "tsx watch src/server/main.ts",
		"dev:web": "vite",
		"start": "node dist/server/main.js",
		"check": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest --run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "file:../packages/coding-agent",
		"node-pty": "^1.1.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/diff": "^8.0.0",
		"@types/node": "^22.10.5",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@types/ws": "^8.18.0",
		"@vitejs/plugin-react": "^5.0.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"diff": "^8.0.0",
		"dompurify": "^3.2.0",
		"lucide-react": "^1.0.0",
		"marked": "^16.0.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router-dom": "^7.6.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.0"
	}
}
